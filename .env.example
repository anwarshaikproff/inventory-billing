# TechMart POS & Inventory System Database Configuration

# OPTION 1: Using MySQL Connection URI (pymysql-friendly)
# DATABASE_URL=mysql://username:password@host:port/database

# OPTION 2: Using individual MySQL parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root_password
MYSQL_DB=inventory_db

# Session Security Key
FLASK_SECRET_KEY=techmart_secret_key_987654321
